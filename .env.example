# Supabase remote persistence AND Google Workspace SSO (optional — without
# these the app runs in local-only mode, persisting to this browser's
# localStorage, with no login gate).
#
# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# Project Settings → API. The publishable key is designed to be exposed to
# browsers; never put the service-role key or database password here.
#
# For auth to work you must also, in the Supabase dashboard: apply
# supabase/migrations/0002_auth.sql (edit the roster emails first), enable the
# Google provider under Authentication → Providers with a Google OAuth client,
# and add your app URL(s) under Authentication → URL Configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
